# OSHEQ certificate backend — environment sample
# Copy to .env (local) or add these in Vercel → Settings → Environment Variables.

PORT=4000

# Frontend ka public domain (CORS + links ke liye)
PUBLIC_BASE_URL=https://your-frontend.vercel.app

# QR / verify page ka domain. Khaali chhodne par backend request host se khud nikal leta hai.
BACKEND_BASE_URL=https://your-backend.vercel.app

# Cloudinary (PDF + PNG ka permanent storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional
WORK_DIR=/tmp/osheq-work
QR_MODE=verify
