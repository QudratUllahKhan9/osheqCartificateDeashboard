# ==========================================================
#  OSHEQ Certificate Backend — server environment
#  Copy to .env  ->  cp .env.example .env
#  Kabhi bhi .env git me commit NA karein.
# ==========================================================

# ---------------- Server ----------------
# Port jo Node sunega (nginx iske aage reverse proxy karega)
PORT=4000
NODE_ENV=production

# QR ke andar YAHI URL jata hai. Phone scan karega, is liye PUBLIC HTTPS hona chahiye.
# Zaroori: https://  +  aapka asli domain. localhost/IP rakha to phone par nahi khulega.
PUBLIC_BASE_URL=https://certificates.your-domain.com

# Render temp files (PDF/PNG). VPS par /var/lib/osheq ya /tmp bhi chalega.
WORK_DIR=/var/lib/osheq/work

# ---------------- Cloudinary ----------------
# dashboard.cloudinary.com -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------- Browser ----------------
# Linux VPS par khali chhod dein — /usr/bin/chromium khud detect ho jata hai.
# Sirf tab bharein jab custom path ho:
# CHROME_PATH=/usr/bin/chromium
CHROME_PATH=

# Extra Chromium flags (space separated), optional
# CHROME_EXTRA_ARGS=--single-process

# Launch timeout (ms)
CHROME_LAUNCH_TIMEOUT=60000
