# ---------------- Server ----------------
PORT=4000

# QR ke andar yahi URL jata hai. Phone scan karega, is liye HTTPS public URL hona chahiye.
# Local test (same computer only):  http://localhost:4000
# Deploy ke baad:                  https://your-backend.vercel.app
PUBLIC_BASE_URL=http://localhost:4000

# ---------------- Cloudinary ----------------
# dashboard.cloudinary.com -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------- Local Chrome (Windows only) ----------------
# Vercel par set na karein. @sparticuz/chromium khud use hota hai.
CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
